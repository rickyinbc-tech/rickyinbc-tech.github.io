{
  "schemaVersion": 2,
  "purpose": "Authoritative artwork and owned collection-image governance for image discovery, structured data, artwork navigation, and multilingual pages.",
  "recordPolicy": {
    "publicModel": "One governed core record in three languages, with extended evidence modules only where verified.",
    "requiredCore": [
      "identity",
      "artwork type",
      "series or project",
      "copyright",
      "related content"
    ],
    "publicUse": "Personal, non-commercial archive only. No products, services, commissions, licensing, or paid work are offered."
  },
  "rights": {
    "copyrightNotice": "Copyright Ricky Kwok",
    "creditText": "Ricky Kwok"
  },
  "imageSitemapPolicy": {
    "eligibility": "Original photography visibly published on an indexable canonical page and identified there as Ricky Kwok's work through ImageObject creator, credit, and copyright metadata.",
    "ownership": "Each original image URL is assigned to one English-language canonical owner page; translated and repeated appearances do not create duplicate sitemap entries.",
    "excluded": [
      "interface and decorative imagery",
      "press, award, and reference assets",
      "responsive derivatives",
      "unused assets",
      "images without matching creator and copyright evidence on the owner page"
    ]
  },
